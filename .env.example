CROWDSEC_LAPI_URL=http://192.168.1.10:8301
CROWDSEC_BOUNCER_KEY=
CROWDSEC_MACHINE_ID=
CROWDSEC_MACHINE_PASSWORD=
POLL_INTERVAL_SECONDS=15
DB_PATH=/data/dashboard.db
RETENTION_DAYS=90
REPEAT_OFFENDER_THRESHOLD=3
COUNTRY_BAN_THRESHOLD=10

# Optional: automatically email the network's abuse contact once an IP
# crosses AUTO_ABUSE_THRESHOLD bans (instead of using the manual "Prepare
# abuse report" button). Off by default. Leave AUTO_ABUSE_REPORT unset/false
# to keep the current manual-only behavior.
AUTO_ABUSE_REPORT=false
AUTO_ABUSE_THRESHOLD=8
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Required to save an SMTP password via the Settings page in the web UI
# (see app/secrets_store.py) — nothing else in the dashboard needs it. Leave
# unset and the app still starts and runs normally; the Settings page just
# shows the SMTP password field as disabled with an explanation, and refuses
# to save a new password until this is set. There is no auto-generated
# fallback key. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_SECRET_KEY=
