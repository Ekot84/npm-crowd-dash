CROWDSEC_LAPI_URL=http://192.168.1.10:8301
CROWDSEC_BOUNCER_KEY=
CROWDSEC_MACHINE_ID=
CROWDSEC_MACHINE_PASSWORD=
POLL_INTERVAL_SECONDS=15
DB_PATH=/data/dashboard.db
RETENTION_DAYS=90
REPEAT_OFFENDER_THRESHOLD=3
COUNTRY_BAN_THRESHOLD=10

# Optional: automatically email the network's abuse contact once an IP
# crosses AUTO_ABUSE_THRESHOLD bans (instead of using the manual "Prepare
# abuse report" button). Off by default. Leave AUTO_ABUSE_REPORT unset/false
# to keep the current manual-only behavior.
AUTO_ABUSE_REPORT=false
AUTO_ABUSE_THRESHOLD=8
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: encrypts the SMTP password when it's saved via the Settings
# page in the web UI (see app/secrets_store.py). Leave unset and a key is
# auto-generated on first run and stored next to the database instead —
# works fine, just means the key travels with the database in any backup.
# Set this to keep the key separate. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_SECRET_KEY=
