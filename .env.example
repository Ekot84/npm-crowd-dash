CROWDSEC_LAPI_URL=http://192.168.1.10:8301
CROWDSEC_BOUNCER_KEY=
CROWDSEC_MACHINE_ID=
CROWDSEC_MACHINE_PASSWORD=
POLL_INTERVAL_SECONDS=15
DB_PATH=/data/dashboard.db
RETENTION_DAYS=90
REPEAT_OFFENDER_THRESHOLD=3
COUNTRY_BAN_THRESHOLD=10

# Public IP of the server that received the attacks, included in abuse reports.
# Use the attacked address, which may differ from the dashboard's outgoing IP.
REPORT_PUBLIC_IP=

# Once a repeat local offender's ban count reaches the threshold, push a
# manual long-duration ban decision straight to CrowdSec (in addition to,
# not instead of, an abuse report). Off by default — test it manually
# against the LAPI first with a short duration, since once enabled this
# acts on real IPs automatically, every poll cycle.
REPEAT_OFFENDER_ESCALATION_ENABLED=false
REPEAT_OFFENDER_ESCALATION_THRESHOLD=8
REPEAT_OFFENDER_ESCALATION_DURATION=8760h

# Used by the Reports page to actually send an abuse report you've reviewed
# there — nothing is ever emailed automatically. Leave these unset and the
# rest of the dashboard works fine; the "Send report" button just fails with
# a clear "SMTP not configured" message until they're filled in (here or on
# the Settings page).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Required to save an SMTP password via the Settings page in the web UI
# (see app/secrets_store.py) — nothing else in the dashboard needs it. Leave
# unset and the app still starts and runs normally; the Settings page just
# shows the SMTP password field as disabled with an explanation, and refuses
# to save a new password until this is set. There is no auto-generated
# fallback key. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_SECRET_KEY=
